{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}
        dev.eacl/eacl {:local/root "../eacl"}}
 :aliases {:build {:extra-paths ["."] :ns-default build
                   :extra-deps {eacl/build-tools {:local/root "../../src-build"}}}
           ;; Conformance evidence needs the JVM module (the differential
           ;; reference and the shared corpus) and DataScript (end to end).
           :test {:extra-paths ["test" "../eacl/test" "../eacl-caveats-jvm/test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/test.check {:mvn/version "1.1.3"}
                               dev.eacl/eacl-caveats-jvm {:local/root "../eacl-caveats-jvm"}
                               dev.eacl/eacl-datascript {:local/root "../eacl-datascript"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test" "../eacl/test"]
                              :patterns ["^(?!eacl[.]bench[.])(?!eacl[.]characterization-fixture-test$)(?!eacl[.]formal[.]).*-test$"]}}
           :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                   :main-opts ["-m" "nrepl.cmdline"]}}}
