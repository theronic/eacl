{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}
        dev.eacl/eacl {:local/root "../eacl"}
        com.rpl/specter {:mvn/version "1.1.4"}
        datascript/datascript {:mvn/version "1.7.8"}}
 :aliases {:build {:extra-paths ["."]
                   :ns-default build
                   :extra-deps {eacl/build-tools {:local/root "../../src-build"}}}
           :test {:extra-paths ["test" "../eacl/test"]
                  :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test" "../eacl/test"]}}
           :cljs-test {:extra-paths ["test" "../eacl/test"]
                       :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}
                       :main-opts ["-m" "cljs.main"
                                   "-t" "node"
                                   "-O" "none"
                                   "-o" "target/datascript-cljs-test.js"
                                   "-c" "eacl.datascript.cljs-test-runner"]}
           :nrepl {:extra-paths ["test" "../eacl/test"]
                   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                   :main-opts ["-m" "nrepl.cmdline"]}}}
