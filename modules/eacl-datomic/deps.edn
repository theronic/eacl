{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}
        dev.eacl/eacl {:local/root "../eacl"}
        com.rpl/specter {:mvn/version "1.1.4"}
        com.datomic/peer {:mvn/version "1.0.7705"}}
 :aliases {:build {:extra-paths ["."]
                   :ns-default build
                   :extra-deps {eacl/build-tools {:local/root "../../src-build"}}}
           :test {:extra-paths ["test" "../eacl/test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               criterium/criterium {:mvn/version "0.4.6"}}
                  :exec-fn cognitect.test-runner.api/test
                  ;; Cross-backend benchmark namespaces live under this test
                  ;; root so the aggregate repository classpath can run them.
                  ;; Filter them before require-time in the isolated module:
                  ;; `:excludes` only filters vars after namespaces load.
                  :exec-args
                  {:dirs ["test" "../eacl/test"]
                   :patterns ["^(?!eacl[.]bench[.])(?!eacl[.]operator-engine[.]cross-backend-operator-test$).*-test$"]}}
           :nrepl {:extra-paths ["test" "../eacl/test"]
                   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                   :main-opts ["-m" "nrepl.cmdline"]}}}
