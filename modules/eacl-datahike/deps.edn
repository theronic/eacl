{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0-alpha5"}
        cloudafrica/eacl {:local/root "../eacl"}
        ;; Needs the composite-tuple fix (replikativ/datahike#921): without it EVERY
        ;; relation and permission tuple silently fails to derive under
        ;; :attribute-refs?, so every permission denies. Merged to datahike main but
        ;; not yet tagged — switch to an :mvn/version once released.
        org.replikativ/datahike {:local/root "../../../datahike"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
           :nrepl {:extra-paths ["test"]
                   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                   :main-opts ["-m" "nrepl.cmdline"]}}}
