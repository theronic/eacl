{:backend :datomic
 :client-option
 {:cache
  {:remember-answers true
   :subproblem-cache
   {:enabled? false
    :denotation-max-entries 19
    :answer-max-entries 17}}}
 :before-fix
 {:outcome :rejected
  :type :eacl/invalid-config
  :unknown-keys [:subproblem-cache]}
 :latent-defaults
 {:enabled? true
  :denotation-max-entries 4096
  :answer-max-entries 1024}}
