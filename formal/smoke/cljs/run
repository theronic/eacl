#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
port=${EACL_NREPL_PORT:-}

[ -n "$port" ] || {
  printf '%s\n' \
    "EACL_NREPL_PORT must name an nREPL started with:" \
    "  clojure -M:dev:formal-smoke:formal-cljs-smoke:nrepl --port 0" >&2
  exit 2
}

clj-nrepl-eval -p "$port" --timeout 120000 \
  "(do
     (require '[cljs.main :as cljs] :reload)
     (cljs/-main
       \"-t\" \"node\"
       \"-O\" \"none\"
       \"-o\" \"target/formal/cljs-smoke.js\"
       \"-c\" \"eacl.formal.cljs-test-runner\"))"

exec node "$repo_root/target/formal/cljs-smoke.js"
