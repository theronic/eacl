#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
generated="$repo_root/target/formal/java"
classes="$generated/classes"
dafny_runtime="$repo_root/target/formal-tools/dafny-4.11.0/dafny/DafnyRuntime.jar"

[ -f "$dafny_runtime" ] || {
  printf '%s\n' "missing Dafny runtime; run bin/formal bootstrap" >&2
  exit 1
}

rm -rf "$classes"
mkdir -p "$classes"

find "$generated" -type f -name '*.java' -print |
  sort >"$generated/java-sources.txt"
[ -s "$generated/java-sources.txt" ] || {
  printf '%s\n' "Dafny generated no Java sources" >&2
  exit 1
}

javac -cp "$dafny_runtime" -d "$classes" @"$generated/java-sources.txt"

printf '%s\n' \
  "Generated Java compiled. Run the smoke test through nREPL with:" \
  "  clojure -M:formal-smoke:nrepl"
