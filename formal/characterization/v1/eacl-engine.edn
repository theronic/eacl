    eacl.cache-test/cache-configuration-is-count-only-and-client-private-test]}

  {:id :typed-errors
   :expected {:unsupported-filter :eacl.pagination/unsupported-filter
              :invalid-cursor :eacl.pagination/invalid-cursor
              :expired-cursor :eacl.pagination/expired-cursor}
   :covered-by
   [eacl.datomic.v8-characterization-test/extraction-preserves-public-v8-behavior-test
    eacl.secure-format-test/portable-cursor-expiry-boundary-test]}]}
