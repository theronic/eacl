              :scope-error :eacl.pagination/invalid-cursor
              :expiry-boundary :exclusive}
   :covered-by
   [eacl.datomic.v8-characterization-test/extraction-preserves-public-v8-behavior-test
    eacl.secure-format-test/portable-cursor-expiry-boundary-test]}

