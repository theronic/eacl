{:paths ["modules/eacl/src"
         "modules/eacl-datomic/src"
         "modules/eacl-datascript/src"
         "modules/eacl-datahike/src"
         "resources"
         "target/formal/java/classes"
         "target/formal/browser"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}

        ;; Concurrent JVM cache implementation used by EACL's private CLJC
        ;; storage boundary. ClojureScript uses the fork below instead.
        com.github.ben-manes.caffeine/caffeine {:mvn/version "3.2.4"}

        ;; CLJS/DataScript demos use the tested fork directly. JVM Maven
        ;; metadata intentionally does not encode this Git-only dependency.
        com.github.theronic/cljs-cache
        {:git/url "https://github.com/theronic/cljs-cache.git"
         :git/sha "4143cc036446a47f0c6dfd9f8dde90363835051c"}

           ; Specter for coercing objects in deep structures
        com.rpl/specter {:mvn/version "1.1.4"}

           ;; Datomic
        com.datomic/peer {:mvn/version "1.0.7705"}
        datascript/datascript {:mvn/version "1.7.8"}
        ;; 0.8.1759 is the first release carrying replikativ/datahike#921
        ;; (composite tuples derived + validated under :attribute-refs?)
        org.replikativ/datahike
        {:mvn/version "0.8.1759"
         :exclusions [com.github.pkpkpk/cljs-cache]}

        ;; Parsing
        instaparse/instaparse {:mvn/version "1.5.0"}}
 :aliases {:formal-smoke
           {:extra-paths ["formal/smoke/shared"
                          "formal/smoke/clj"]
            :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}}
           :formal-cljs-smoke
           {:extra-paths ["formal/smoke/shared"
                          "formal/smoke/cljs"]
            :extra-deps {org.clojure/clojurescript
                         {:mvn/version "1.12.42"}}}
           :dev {:extra-paths ["modules/eacl/test"
                               "modules/eacl-datomic/test"
                               "modules/eacl-datascript/test"
                               "modules/eacl-datahike/test"]}
           ;; The fork is deliberately opt-in until its immutable source commit
           ;; and Maven artifact are public. This keeps ordinary workspace CI
           ;; from silently depending on a sibling checkout.
           :datalevin-dev
           {:extra-paths ["modules/eacl-datalevin/src"
                          "modules/eacl-datalevin/test"
                          "modules/eacl/test"]
            :extra-deps
            {dev.eacl/datalevin-embedded-eacl {:local/root "../datalevin"}}
            :jvm-opts ["--add-opens=java.base/java.lang=ALL-UNNAMED"
                       "--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/java.util=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"]}
           :datalevin-test
           {:extra-paths ["modules/eacl-datalevin/src"
                          "modules/eacl-datalevin/test"
                          "modules/eacl/test"]
            :extra-deps
            {dev.eacl/datalevin-embedded-eacl {:local/root "../datalevin"}
             io.github.cognitect-labs/test-runner
             {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
            :jvm-opts ["--add-opens=java.base/java.lang=ALL-UNNAMED"
                       "--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/java.util=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"]
            :exec-fn cognitect.test-runner.api/test
            :exec-args {:dirs ["modules/eacl-datalevin/test"
                               "modules/eacl/test"]
                        :patterns ["^(?!eacl[.]bench[.])(?!eacl[.]characterization-fixture-test$)(?!eacl[.]formal[.]).*-test$"]
                        :excludes [:benchmark]}}
           :build-eacl {:extra-paths ["modules/eacl" "src-build"]
                        :ns-default build
                        :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.8"}}}
           :build-eacl-datomic {:extra-paths ["modules/eacl-datomic" "src-build"]
                                :ns-default build
                                :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.8"}}}
           :build-eacl-datahike {:extra-paths ["modules/eacl-datahike" "src-build"]
                                 :ns-default build
                                 :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.8"}}}
           :build-eacl-datascript {:extra-paths ["modules/eacl-datascript" "src-build"]
                                   :ns-default build
                                   :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.8"}}}
           :build-eacl-datalevin {:extra-paths ["modules/eacl-datalevin" "src-build"]
                                  :ns-default build
                                  :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.8"}}}
           :build-test {:extra-paths ["src-build"]
                        :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.8"}}}
           :release-guard
           {:extra-paths ["src-build"]
            :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}
            :main-opts ["-m" "eacl.release-guard"]}
           :release
           {:extra-paths ["src-build"]
            :extra-deps
            {io.github.clojure/tools.build {:mvn/version "0.10.8"}
             org.clojure/data.json {:mvn/version "2.5.1"}
             slipset/deps-deploy {:mvn/version "0.2.5"}}
            :exec-fn eacl.build.release/build-install-smoke}
           :deploy
           {:extra-paths ["src-build"]
            :extra-deps
            {io.github.clojure/tools.build {:mvn/version "0.10.8"}
             org.clojure/data.json {:mvn/version "2.5.1"}
             slipset/deps-deploy {:mvn/version "0.2.5"}}
            :exec-fn eacl.build.release/deploy}
           :cljs-test {:extra-paths ["modules/eacl/test"
                                     "modules/eacl-datascript/test"]
                       :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}}
           :datascript-cljs-test {:extra-paths ["modules/eacl/test"
                                                "modules/eacl-datascript/test"]
                                  :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}
                                  :main-opts ["-m" "cljs.main"
                                              "-t" "node"
                                              "-O" "none"
                                              "-o" "target/datascript-cljs-test.js"
                                              "-c" "eacl.datascript.cljs-test-runner"]}
           :test {:extra-paths ["modules/eacl/test"
                                "modules/eacl-datomic/test"
                                "modules/eacl-datascript/test"
                                "modules/eacl-datahike/test"
                                "src-build"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               io.github.clojure/tools.build {:mvn/version "0.10.8"}
                               criterium/criterium {:mvn/version "0.4.6"}}
                  :main-opts ["-m" "cognitect.test-runner"
                              "-d" "modules/eacl/test"
                              "-d" "modules/eacl-datomic/test"
                              "-d" "modules/eacl-datascript/test"
                              "-d" "modules/eacl-datahike/test"
                              "-d" "src-build"]
                  :exec-fn cognitect.test-runner.api/test
                  ;; Scan module test dirs only.
                  :exec-args {:dirs ["modules/eacl/test"
                                     "modules/eacl-datomic/test"
                                     "modules/eacl-datascript/test"
                                     "modules/eacl-datahike/test"
                                     "src-build"]}}
           :nrepl {:extra-paths ["modules/eacl/test"
                                 "modules/eacl-datomic/test"
                                 "modules/eacl-datascript/test"
                                 "modules/eacl-datahike/test"]
                   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                   :main-opts ["-m" "nrepl.cmdline"]}}}
