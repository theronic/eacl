#!/usr/bin/env bb

(require '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.set :as set]
         '[clojure.string :as str])

(import '[java.security MessageDigest])

(def repo-root
  (.getCanonicalFile
   (io/file (or (System/getenv "EACL_REPO_ROOT") "."))))

(def manifest-path
  (or (System/getenv "EACL_VERIFICATION_MANIFEST")
      "target/formal/verification/manifest.edn"))

(def contract-path
  (or (System/getenv "EACL_ASSURANCE_CONTRACT")
      "formal/assurance_contract.clj"))

(def closure-path
  (or (System/getenv "EACL_PUBLIC_SOURCE_CLOSURE_OUTPUT")
      "target/formal/verification/public-source-closure.json"))

(def dafny-report-path
  (or (System/getenv "EACL_DAFNY_VERIFICATION_REPORT")
      "target/formal/dafny-verification.json"))

(def invalid-evidence-exit 2)
(def assurance-withheld-exit 3)

(defn repo-file [path]
  (let [file (io/file path)]
    (if (.isAbsolute file) file (io/file repo-root path))))

(defn read-edn [path]
  (edn/read-string (slurp (repo-file path))))

(defn display-path [path]
  (let [file (.getCanonicalFile (repo-file path))]
    (if (.startsWith (.toPath file) (.toPath repo-root))
      (-> (.toPath repo-root)
          (.relativize (.toPath file))
          str
          (str/replace "\\" "/"))
      (.getPath file))))

(defn fail!
  ([message data] (fail! invalid-evidence-exit message data))
  ([exit-code message data]
   (binding [*out* *err*]
     (println message)
     (prn data))
   (System/exit exit-code)))

(defn sha256 [file]
  (with-open [input (io/input-stream file)]
    (let [digest (MessageDigest/getInstance "SHA-256")
          buffer (byte-array 16384)]
      (loop []
        (let [read (.read input buffer)]
          (when-not (= -1 read)
            (.update digest buffer 0 read)
            (recur))))
      (apply str
             (map #(format "%02x" (bit-and (int %) 255))
                  (.digest digest))))))

(defn files-under [path suffix]
  (->> (file-seq (repo-file path))
       (filter #(.isFile %))
       (filter #(str/ends-with? (.getName %) suffix))))

(defn policy-sources [{:keys [source sources]}]
  (cond source [source] (seq sources) sources :else nil))

(let [manifest (read-edn manifest-path)
      contract (load-file (.getPath (repo-file contract-path)))
      policies (:theorem-policies contract)
      release-policy (:release-policy contract)
      dafny-report
      (json/parse-string (slurp (repo-file dafny-report-path)) true)
      dafny-counts
      (into {} (map (juxt :source :proofEfforts)) (:modules dafny-report))
      theorem-results
      (into
       (sorted-map)
       (map
        (fn [[claim policy]]
          (let [actual
                (if (= claim :complete-public-engine)
                  (get-in dafny-report [:aggregate :proofEfforts])
                  (let [counts
                        (mapv #(get dafny-counts (.getName (io/file %)))
                              (policy-sources policy))]
                    (when (every? integer? counts) (reduce + counts))))]
            [claim
             (assoc policy
                    :proof-efforts actual
                    :status
                    (if (and (integer? actual)
                             (<= (:minimum-proof-efforts policy) actual))
                      :passed
                      :failed))])))
       policies)
      closure
      (json/parse-string (slurp (repo-file closure-path)) true)
      closure-summary
      {:report (display-path closure-path)
       :source-files (count (:sources closure))
       :public-roots (get-in closure [:scope :rootCount])
       :reachable-definitions
       (get-in closure [:scope :unionInternalDefinitionCount])}
      mutation-registry (read-edn "formal/mutations/registry.edn")
      mutation-summary
      {:registry "formal/mutations/registry.edn"
       :registered (count (:mutants mutation-registry))
       :retired-invalid-controls
       (count (mapcat :ids (:retired-mutant-groups mutation-registry)))}
      stable-script
      (slurp (repo-file "formal/stable-discovery/verify-fast.sh"))
      stable-summary
      {:gate "formal/stable-discovery/verify-fast.sh"
       :dafny-leaves (count (files-under "formal/stable-discovery" ".dfy"))
       :verified-obligations
       (some->> stable-script
                (re-find #"expected_dafny_obligations=([0-9]+)")
                second
                parse-long)}
      actual-dafny
      (->> (files-under "formal/dafny" ".dfy")
           (map #(str "formal/dafny/" (.getName %)))
           set)
      covered-dafny
      (->> (:operation-contracts contract)
           (mapcat :dafny)
           (filter #(str/starts-with? % "formal/dafny/"))
           set)
      counterexample-ids
      (->> (files-under "formal/counterexamples" "entry.edn")
           (filter #(= "entry.edn" (.getName %)))
           (map #(-> % slurp edn/read-string :id))
           sort
           vec)
      source-digest-mismatches
      (into
       []
       (keep
        (fn [[path expected]]
          (let [file (repo-file path)]
            (cond
              (not (.isFile file)) {:path path :problem :missing}
              (not= expected (sha256 file))
              {:path path :problem :digest-mismatch
               :recorded expected :actual (sha256 file)}))))
       (:source-digests manifest))
      missing-generated
      (into []
            (keep (fn [[target digest]]
                    (when (= :not-built digest) target)))
            (:generated-artifact-digests manifest))
      errors
      (cond-> []
        (not= 2 (:schema-version manifest))
        (conj {:claim :schema-version :actual (:schema-version manifest)})
        (not= "formal/assurance_contract.clj" (:contract manifest))
        (conj {:claim :contract :actual (:contract manifest)})
        (not= release-policy (:release-policy manifest))
        (conj {:claim :release-policy})
        (not= (:assurance-status release-policy)
              (:assurance-status manifest))
        (conj {:claim :assurance-status})
        (not= theorem-results (:theorems manifest))
        (conj {:claim :theorem-results
               :failed (->> theorem-results
                            (filter (comp #{:failed} :status val))
                            (map key)
                            vec)})
        (not= closure-summary (:source-closure manifest))
        (conj {:claim :source-closure
               :expected closure-summary
               :actual (:source-closure manifest)})
        (not= mutation-summary (:mutation-controls manifest))
        (conj {:claim :mutation-controls
               :expected mutation-summary
               :actual (:mutation-controls manifest)})
        (not= stable-summary (:stable-discovery manifest))
        (conj {:claim :stable-discovery
               :expected stable-summary
               :actual (:stable-discovery manifest)})
        (not= actual-dafny covered-dafny)
        (conj {:claim :dafny-operation-coverage
               :missing (sort (set/difference actual-dafny covered-dafny))
               :extra (sort (set/difference covered-dafny actual-dafny))})
        (empty? (:source-digests manifest))
        (conj {:claim :source-digests :problem :absent})
        (seq source-digest-mismatches)
        (conj {:claim :source-digests
               :mismatches source-digest-mismatches})
        (seq missing-generated)
        (conj {:claim :generated-artifacts
               :missing missing-generated})
        (not= {:latest (last counterexample-ids) :fixed counterexample-ids}
              (:counterexample-corpus-revision manifest))
        (conj {:claim :counterexample-corpus-revision}))
      unmet (:unmet-required-obligations release-policy)
      allowed? (:verified-status-allowed? release-policy)
      external (:external-certification release-policy)]
  (when (seq errors)
    (fail! "Generated verification evidence disagrees with live sources."
           {:errors errors}))
  (when (and (seq unmet) allowed?)
    (fail! "Unmet obligations cannot allow verified status."
           {:unmet-required-obligations unmet}))
  (when (and (= :externally-certified
                (:assurance-status release-policy))
             (not
              (and (= :signed (:status external))
                   (every? #(and (string? %) (not (str/blank? %)))
                           ((juxt :reviewer :organization :reviewed-at :scope)
                            external))
                   (re-matches #"[0-9a-f]{40}" (:source-commit external ""))
                   (re-matches #"[0-9a-f]{64}" (:bundle-sha256 external "")))))
    (fail! "External certification requires an independently bound sign-off."
           {:external-certification external}))
  (when (seq unmet)
    (fail!
     assurance-withheld-exit
     "Verification status is withheld: required obligations are unmet."
     {:assurance-status (:assurance-status release-policy)
      :verified-status-allowed? allowed?
      :unmet-required-obligations unmet
      :theorems :passed
      :generated-artifacts (:generated-artifact-digests manifest)}))
  (println
   (pr-str
    {:assurance-status (:assurance-status release-policy)
     :verified-status-allowed? allowed?
     :unmet-required-obligations unmet
     :theorems :passed
     :generated-artifacts (:generated-artifact-digests manifest)})))
