#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
lock_file="$repo_root/formal/toolchain.lock.json"
cache_root="${EACL_FORMAL_CACHE:-$repo_root/target/formal-tools}"
output_root="${EACL_FORMAL_OUTPUT:-$repo_root/target/formal}"

lock_value() {
  node -e '
    const fs = require("fs");
    const value = process.argv[2].split(".").reduce(
      (current, key) => current === undefined ? undefined : current[key],
      JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
    );
    if (value === undefined || typeof value === "object") process.exit(2);
    process.stdout.write(String(value));
  ' "$lock_file" "$1"
}

dafny_version=$(lock_value tools.dafny.version)
apalache_version=$(lock_value tools.apalache.version)
tla_version=$(lock_value tools.tla2tools.version)
dafny_time_limit=$(lock_value verificationPolicy.dafny.assertionBatchTimeLimitSeconds)
dafny_resource_limit=$(lock_value verificationPolicy.dafny.proofEffortResourceLimit)
dafny="$cache_root/dafny-$dafny_version/dafny/dafny"
apalache="$cache_root/apalache-$apalache_version/bin/apalache-mc"
tla_jar="$cache_root/tla2tools-$tla_version.jar"

usage() {
  printf '%s\n' \
    "usage: bin/formal <command>" \
    "" \
    "commands:" \
    "  bootstrap             install and checksum-check locked tools" \
    "  format                check Dafny source formatting" \
    "  verify                verify every Dafny project" \
    "  compile-java          translate the executable kernel to Java" \
    "  compile-js            translate the executable kernel to JavaScript" \
    "  build-java            compile the translated Java smoke boundary" \
    "  build-js              execute the translated JavaScript smoke boundary" \
    "  browser-bundle        bundle generated JavaScript for browsers" \
    "  artifact-size         check rebuilt generated artifacts against reviewed bounds" \
    "  source-closure        generate the public engine source dependency report" \
    "  counterexample-replay replay every minimized bug through nREPL" \
    "  mutation-control      run registered mutation controls via nREPL" \
    "  gate-selftest         prove the nREPL gates fail on failing suites" \
    "  manifest              validate the release assurance gate" \
    "  tla-typecheck         parse and typecheck TLA+ models" \
    "  apalache-check        run bounded temporal safety checks" \
    "  apalache-scheduled    run the larger scheduled temporal bound" \
    "  apalache-invariant    check inductive-invariant obligations" \
    "  apalache-mutation-control require temporal cache mutants to fail" \
    "  all                   run all proof and build checks"
}

need_tools() {
  [ -x "$dafny" ] && [ -x "$apalache" ] && [ -f "$tla_jar" ] ||
    "$repo_root/bin/bootstrap-formal-tools"
}

dafny_sources() {
  find "$repo_root/formal/dafny" -type f -name '*.dfy' -print | sort
}

apalache_check() {
  label=$1
  model=$2
  config=$3
  length=$4
  run_dir=$(mktemp -d "$output_root/apalache/$label.XXXXXX")
  "$apalache" \
    --out-dir="$output_root/apalache" \
    --run-dir="$run_dir" \
    check \
    --config="$config" \
    --inv=Safety \
    --length="$length" \
    "$model"
}

apalache_induction() {
  label=$1
  model=$2
  config=$3
  init_dir=$(mktemp -d "$output_root/apalache/$label-initiation.XXXXXX")
  next_dir=$(mktemp -d "$output_root/apalache/$label-consecution.XXXXXX")
  safety_dir=$(mktemp -d "$output_root/apalache/$label-implication.XXXXXX")
  "$apalache" \
    --out-dir="$output_root/apalache" \
    --run-dir="$init_dir" \
    check \
    --config="$config" \
    --init=Init \
    --inv=InductiveInvariant \
    --length=0 \
    "$model"
  "$apalache" \
    --out-dir="$output_root/apalache" \
    --run-dir="$next_dir" \
    check \
    --config="$config" \
    --init=InductiveInvariant \
    --inv=InductiveInvariant \
    --length=1 \
    "$model"
  "$apalache" \
    --out-dir="$output_root/apalache" \
    --run-dir="$safety_dir" \
    check \
    --config="$config" \
    --init=InductiveInvariant \
    --inv=Safety \
    --length=0 \
    "$model"
}

apalache_expect_counterexample() {
  label=$1
  model=$2
  config=$3
  length=$4
  run_dir=$(mktemp -d "$output_root/apalache/$label.XXXXXX")
  log_file="$run_dir/control.log"
  if "$apalache" \
    --out-dir="$output_root/apalache" \
    --run-dir="$run_dir" \
    check \
    --config="$config" \
    --inv=Safety \
    --length="$length" \
    "$model" >"$log_file" 2>&1
  then
    status=0
  else
    status=$?
  fi
  if [ "$status" -ne 12 ]; then
    cat "$log_file" >&2
    printf 'mutation control %s returned %s, expected counterexample exit 12\n' \
      "$label" "$status" >&2
    return 1
  fi
  printf 'killed temporal mutant: %s\n' "$label"
}

nrepl_eval() {
  eval_port=$1
  eval_timeout_ms=$2
  eval_form=$3
  if command -v clj-nrepl-eval >/dev/null 2>&1; then
    exec clj-nrepl-eval \
      -p "$eval_port" \
      --timeout "$eval_timeout_ms" \
      "$eval_form"
  fi
  exec sh "$repo_root/bin/ci-nrepl-eval" "$eval_port" "$eval_form"
}

command=${1:-}
case "$command" in
  bootstrap)
    exec "$repo_root/bin/bootstrap-formal-tools"
    ;;
  format)
    need_tools
    # shellcheck disable=SC2046
    exec "$dafny" format --check $(dafny_sources)
    ;;
  verify)
    need_tools
    resource_output_dir="$output_root/dafny-resources"
    resource_summary="$output_root/dafny-verification.json"
    rm -rf "$resource_output_dir"
    mkdir -p "$resource_output_dir"
    for source in $(dafny_sources); do
      source_name=$(basename "$source" .dfy)
      "$dafny" verify \
        --verification-time-limit "$dafny_time_limit" \
        --resource-limit "$dafny_resource_limit" \
        --log-format \
        "csv;LogFileName=$resource_output_dir/$source_name.csv" \
        "$source"
    done
    exec node "$repo_root/bin/summarize-dafny-verification.mjs" \
      "$resource_output_dir" \
      "$dafny_resource_limit" \
      "$resource_summary"
    ;;
  compile-java)
    need_tools
    rm -rf "$output_root/java"
    mkdir -p "$output_root/java"
    "$dafny" translate java \
      --include-runtime \
      --output "$output_root/java/EaclKernel" \
      "$repo_root/formal/dafny/EaclKernel.dfy"
    exec node "$repo_root/bin/patch-generated-collections.mjs" java
    ;;
  compile-js)
    need_tools
    rm -rf "$output_root/js"
    mkdir -p "$output_root/js"
    "$dafny" translate js \
      --include-runtime \
      --output "$output_root/js/EaclKernel" \
      "$repo_root/formal/dafny/EaclKernel.dfy"
    exec node "$repo_root/bin/patch-generated-collections.mjs" js
    ;;
  build-java)
    need_tools
    "$repo_root/bin/formal" compile-java
    exec "$repo_root/formal/smoke/java/run"
    ;;
  build-js)
    need_tools
    "$repo_root/bin/formal" compile-js
    npm ci --ignore-scripts --prefix "$repo_root/formal/smoke/js"
    exec node "$repo_root/formal/smoke/js/round_trip.mjs" \
      "$output_root/js/EaclKernel.js"
    ;;
  browser-bundle)
    need_tools
    "$repo_root/bin/formal" compile-js
    npm ci --ignore-scripts --prefix "$repo_root/formal/smoke/js"
    node "$repo_root/formal/smoke/js/build_browser_bundle.mjs"
    cp "$repo_root/formal/smoke/js/browser_smoke.html" \
      "$output_root/browser/index.html"
    ;;
  artifact-size)
    exec "$repo_root/bin/check-generated-artifact-size"
    ;;
  source-closure)
    EACL_REPO_ROOT="$repo_root" \
      EACL_PUBLIC_SOURCE_CLOSURE_OUTPUT="$output_root/verification/public-source-closure.json" \
      exec "$repo_root/bin/public-source-closure.mjs" check
    ;;
  mutation-control)
    if [ -z "${EACL_NREPL_PORT:-}" ]; then
      printf '%s\n' \
        "EACL_NREPL_PORT must name a running dev nREPL." >&2
      exit 2
    fi
    nrepl_eval "$EACL_NREPL_PORT" 60000 \
      "(do
         (require 'eacl.formal.generators :reload)
         (require 'eacl.formal.mutation-control-test :reload)
         (let [result
               (clojure.test/run-tests 'eacl.formal.mutation-control-test)]
           (when (pos? (+ (:fail result 0) (:error result 0)))
             (throw (ex-info \"mutation controls failed\" result)))
           result))"
    ;;
  counterexample-replay)
    if [ -z "${EACL_NREPL_PORT:-}" ]; then
      printf '%s\n' \
        "EACL_NREPL_PORT must name a running dev nREPL." >&2
      exit 2
    fi
    nrepl_eval "$EACL_NREPL_PORT" 180000 \
      "(do
         ;; Persistent nREPLs may have reloaded the shared CacheStore protocol.
         ;; Reload its Datomic implementation before constructing replay
         ;; fixtures, then reload every lazily resolved regression namespace.
         (require 'eacl.cache :reload)
         (require 'eacl.subproblem-cache :reload)
         (require 'eacl.datomic.cache :reload)
         (doseq [test-ns
                 '[eacl.bench.pagination-test
                   eacl.datomic.lookup-cache-test
                   eacl.datomic.cache-test
                   eacl.datomic.cache-review-regressions-test
                   eacl.secure-format-test
                   eacl.cache-test]]
           (require test-ns :reload))
         (require 'eacl.formal.counterexample-replay-test :reload)
         (let [result
               (clojure.test/run-tests
                'eacl.formal.counterexample-replay-test)]
           (when (pos? (+ (:fail result 0) (:error result 0)))
             (throw
              (ex-info \"minimized counterexample replay failed\" result)))
           result))"
    ;;
  gate-selftest)
    if [ -z "${EACL_NREPL_PORT:-}" ]; then
      printf '%s\n' \
        "EACL_NREPL_PORT must name a running dev nREPL." >&2
      exit 2
    fi
    # The replay and mutation-control gates report failure by converting a
    # failing clojure.test summary into a thrown error, because the nREPL
    # eval bridge exits non-zero only when the eval throws. Exercise that
    # conversion in both directions through the exact wrapped shape the
    # gates use: a deliberately failing suite must fail the step, and a
    # passing suite must not.
    selftest_wrapped_run="(let [result
               (clojure.test/run-tests
                'eacl.formal.gate-selftest-suite)]
           (when (pos? (+ (:fail result 0) (:error result 0)))
             (throw (ex-info \"gate selftest suite failed\" result)))
           result)"
    if sh "$repo_root/bin/ci-nrepl-eval" "$EACL_NREPL_PORT" \
      "(do
         (ns eacl.formal.gate-selftest-suite
           (:require [clojure.test :refer [deftest is]]))
         (deftest deliberately-failing-test
           (is (= :expected :deliberate-failure)))
         (in-ns 'user)
         $selftest_wrapped_run)" >/dev/null 2>&1
    then
      printf '%s\n' \
        "gate selftest: a deliberately failing suite exited zero." >&2
      exit 1
    fi
    if sh "$repo_root/bin/ci-nrepl-eval" "$EACL_NREPL_PORT" \
      "(do
         (ns eacl.formal.gate-selftest-suite
           (:require [clojure.test :refer [deftest is]]))
         (deftest deliberately-failing-test
           (is (= :expected :expected)))
         (in-ns 'user)
         $selftest_wrapped_run)" >/dev/null 2>&1
    then
      printf '%s\n' \
        "gate selftest: failing suites fail the step, passing suites pass."
    else
      printf '%s\n' \
        "gate selftest: a passing suite exited non-zero." >&2
      exit 1
    fi
    ;;
  manifest)
    EACL_REPO_ROOT="$repo_root" \
      EACL_PUBLIC_SOURCE_CLOSURE_OUTPUT="$output_root/verification/public-source-closure.json" \
      EACL_VERIFICATION_MANIFEST_OUTPUT="$output_root/verification/manifest.edn" \
      EACL_DAFNY_VERIFICATION_REPORT="$output_root/dafny-verification.json" \
      bb "$repo_root/bin/generate-verification-manifest"
    EACL_REPO_ROOT="$repo_root" \
      EACL_PUBLIC_SOURCE_CLOSURE_OUTPUT="$output_root/verification/public-source-closure.json" \
      EACL_VERIFICATION_MANIFEST="$output_root/verification/manifest.edn" \
      EACL_DAFNY_VERIFICATION_REPORT="$output_root/dafny-verification.json" \
      exec "$repo_root/bin/validate-verification-manifest"
    ;;
  tla-typecheck)
    need_tools
    mkdir -p "$output_root/apalache/typecheck"
    for model in \
      "$repo_root/formal/tla/EaclTemporal.tla" \
      "$repo_root/formal/tla/EaclTemporalDetailed.tla" \
      "$repo_root/formal/tla/EaclSubproblemCache.tla" \
      "$repo_root/formal/tla/EaclTieredSubproblemCache.tla" \
      "$repo_root/formal/tla/EaclManagedProjectionCache.tla" \
      "$repo_root/formal/tla/EaclSpeculativeCache.tla" \
      "$repo_root/formal/tla/EaclOperatorSafety.tla"
    do
      java -cp "$tla_jar" tla2sany.SANY "$model"
      "$apalache" \
        --out-dir="$output_root/apalache/typecheck" \
        typecheck \
        "$model"
    done
    ;;
  apalache-check)
    need_tools
    mkdir -p "$output_root/apalache"
    apalache_check \
      "compact-bounded" \
      "$repo_root/formal/tla/EaclTemporal.tla" \
      "$repo_root/formal/tla/EaclTemporal.cfg" \
      12
    apalache_check \
      "detailed-bounded" \
      "$repo_root/formal/tla/EaclTemporalDetailed.tla" \
      "$repo_root/formal/tla/EaclTemporalDetailed.cfg" \
      6
    apalache_check \
      "subproblem-bounded" \
      "$repo_root/formal/tla/EaclSubproblemCache.tla" \
      "$repo_root/formal/tla/EaclSubproblemCache.cfg" \
      8
    apalache_check \
      "tiered-subproblem-bounded" \
      "$repo_root/formal/tla/EaclTieredSubproblemCache.tla" \
      "$repo_root/formal/tla/EaclTieredSubproblemCache.cfg" \
      5
    apalache_check \
      "managed-projection-bounded" \
      "$repo_root/formal/tla/EaclManagedProjectionCache.tla" \
      "$repo_root/formal/tla/EaclManagedProjectionCache.cfg" \
      8
    apalache_check \
      "speculative-cache-bounded" \
      "$repo_root/formal/tla/EaclSpeculativeCache.tla" \
      "$repo_root/formal/tla/EaclSpeculativeCache.cfg" \
      8
    apalache_check \
      "operator-safety-bounded" \
      "$repo_root/formal/tla/EaclOperatorSafety.tla" \
      "$repo_root/formal/tla/EaclOperatorSafety.cfg" \
      8
    ;;
  apalache-scheduled)
    need_tools
    mkdir -p "$output_root/apalache"
    apalache_check \
      "detailed-scheduled" \
      "$repo_root/formal/tla/EaclTemporalDetailed.tla" \
      "$repo_root/formal/tla/EaclTemporalDetailedLarge.cfg" \
      3
    ;;
  apalache-invariant)
    need_tools
    mkdir -p "$output_root/apalache"
    apalache_induction \
      "compact" \
      "$repo_root/formal/tla/EaclTemporal.tla" \
      "$repo_root/formal/tla/EaclTemporal.cfg"
    apalache_induction \
      "detailed" \
      "$repo_root/formal/tla/EaclTemporalDetailed.tla" \
      "$repo_root/formal/tla/EaclTemporalDetailed.cfg"
    apalache_induction \
      "subproblem" \
      "$repo_root/formal/tla/EaclSubproblemCache.tla" \
      "$repo_root/formal/tla/EaclSubproblemCache.cfg"
    apalache_induction \
      "tiered-subproblem" \
      "$repo_root/formal/tla/EaclTieredSubproblemCache.tla" \
      "$repo_root/formal/tla/EaclTieredSubproblemCache.cfg"
    apalache_induction \
      "managed-projection" \
      "$repo_root/formal/tla/EaclManagedProjectionCache.tla" \
      "$repo_root/formal/tla/EaclManagedProjectionCache.cfg"
    apalache_induction \
      "speculative-cache" \
      "$repo_root/formal/tla/EaclSpeculativeCache.tla" \
      "$repo_root/formal/tla/EaclSpeculativeCache.cfg"
    apalache_induction \
      "operator-safety" \
      "$repo_root/formal/tla/EaclOperatorSafety.tla" \
      "$repo_root/formal/tla/EaclOperatorSafety.cfg"
    ;;
  apalache-mutation-control)
    need_tools
    mkdir -p "$output_root/apalache"
    controls_file=$(mktemp "$output_root/apalache/mutation-controls.XXXXXX")
    bb -e '
      (require (quote [clojure.edn :as edn])
               (quote [clojure.string :as string]))
      (let [registry
            (edn/read-string
             (slurp (first *command-line-args*)))]
        (doseq [{:keys [id control]} (:mutants registry)
                :when (= :apalache (:kind control))]
          (println
           (string/join
            "\t"
            [(name id)
             (:model control)
             (:config control)
             (:length control)]))))' \
      "$repo_root/formal/mutations/registry.edn" >"$controls_file"
    tab=$(printf '\t')
    while IFS="$tab" read -r mutant_id model_path config_path length
    do
      apalache_expect_counterexample \
        "mutant-$mutant_id" \
        "$repo_root/$model_path" \
        "$repo_root/$config_path" \
        "$length"
    done <"$controls_file"
    rm -f "$controls_file"
    ;;
  all)
    "$repo_root/bin/formal" source-closure
    "$repo_root/bin/formal" format
    "$repo_root/bin/formal" verify
    "$repo_root/bin/formal" build-java
    "$repo_root/bin/formal" build-js
    "$repo_root/bin/formal" browser-bundle
    "$repo_root/bin/formal" artifact-size
    "$repo_root/bin/formal" manifest
    "$repo_root/bin/formal" tla-typecheck
    "$repo_root/bin/formal" apalache-check
    "$repo_root/bin/formal" apalache-invariant
    "$repo_root/bin/formal" apalache-mutation-control
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
