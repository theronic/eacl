#!/usr/bin/env bb

(require '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.pprint :as pprint]
         '[clojure.string :as str])

(import '[java.security MessageDigest])

(def repo-root
  (.getCanonicalFile
   (io/file (or (System/getenv "EACL_REPO_ROOT") "."))))

(def output-path
  (or (System/getenv "EACL_VERIFICATION_MANIFEST_OUTPUT")
      "target/formal/verification/manifest.edn"))

(def closure-path
  (or (System/getenv "EACL_PUBLIC_SOURCE_CLOSURE_OUTPUT")
      "target/formal/verification/public-source-closure.json"))

(def dafny-report-path
  (or (System/getenv "EACL_DAFNY_VERIFICATION_REPORT")
      "target/formal/dafny-verification.json"))

(defn repo-file [path]
  (let [file (io/file path)]
    (if (.isAbsolute file) file (io/file repo-root path))))

(defn relative-path [file]
  (-> (.toPath repo-root)
      (.relativize (.toPath (.getCanonicalFile file)))
      str
      (str/replace "\\" "/")))

(defn display-path [path]
  (let [file (.getCanonicalFile (repo-file path))]
    (if (.startsWith (.toPath file) (.toPath repo-root))
      (relative-path file)
      (.getPath file))))

(defn sha256-bytes [bytes]
  (let [digest (.digest (MessageDigest/getInstance "SHA-256") bytes)]
    (apply str (map #(format "%02x" (bit-and (int %) 255)) digest))))

(defn file-digest [file]
  (with-open [input (io/input-stream file)]
    (let [output (java.io.ByteArrayOutputStream.)]
      (io/copy input output)
      (sha256-bytes (.toByteArray output)))))

(defn files-under [path predicate]
  (->> (file-seq (repo-file path))
       (filter #(.isFile %))
       (filter predicate)
       (sort-by relative-path)))

(defn source-extension? [file]
  (some #(str/ends-with? (.getName file) %)
        [".clj" ".cljc" ".cljs"]))

(def source-files
  (distinct
   (concat
    (files-under "formal/dafny" #(str/ends-with? (.getName %) ".dfy"))
    (files-under "formal/tla"
                 #(or (str/ends-with? (.getName %) ".tla")
                      (str/ends-with? (.getName %) ".cfg")))
    (files-under "formal/stable-discovery"
                 #(or (str/ends-with? (.getName %) ".dfy")
                      (str/ends-with? (.getName %) ".tla")
                      (str/ends-with? (.getName %) ".cfg")
                      (source-extension? %)))
    (files-under "formal/policy" #(.isFile %))
    (files-under "formal/baselines" #(.isFile %))
    (files-under
     "modules"
     #(and (or (str/includes? (relative-path %) "/src/")
               (str/includes? (relative-path %) "/test/"))
           (source-extension? %)))
    (files-under "formal/smoke/clj" #(str/ends-with? (.getName %) ".clj"))
    (files-under "formal/smoke/cljs" #(str/ends-with? (.getName %) ".cljs"))
    (files-under "formal/runtime"
                 #(or (str/ends-with? (.getName %) ".java")
                      (str/ends-with? (.getName %) ".js")))
    (map repo-file
         [".github/workflows/formal.yml"
          "bin/check-generated-artifact-size"
          "bin/formal"
          "bin/generate-verification-manifest"
          "bin/patch-generated-collections.mjs"
          "bin/public-source-closure.mjs"
          "bin/summarize-dafny-verification.mjs"
          "bin/validate-verification-manifest"
          "formal/assurance_contract.clj"
          "formal/mutations/registry.edn"
          "formal/smoke/cljs/run"
          "formal/smoke/java/run"
          "formal/toolchain.lock.json"]))))

(defn aggregate-digest [files]
  (when (seq files)
    (sha256-bytes
     (.getBytes
      (apply str
             (map #(str (relative-path %) "\u0000" (file-digest %) "\n")
                  files))
      java.nio.charset.StandardCharsets/UTF_8))))

(def generated-artifacts
  (let [java-files
        (when (.exists (repo-file "target/formal/java"))
          (files-under "target/formal/java"
                       #(or (str/ends-with? (.getName %) ".java")
                            (str/ends-with? (.getName %) ".class"))))
        candidates
        {:dafny-verification (repo-file dafny-report-path)
         :javascript (repo-file "target/formal/js/EaclKernel.js")
         :browser-iife (repo-file "target/formal/browser/EaclKernel.browser.js")}]
    (assoc
     (into (sorted-map)
           (map (fn [[target file]]
                  [target (if (.isFile file) (file-digest file) :not-built)]))
           candidates)
     :java (or (aggregate-digest java-files) :not-built))))

(def contract
  (load-file (.getPath (repo-file "formal/assurance_contract.clj"))))

(def dafny-report
  (json/parse-string (slurp (repo-file dafny-report-path)) true))

(def dafny-counts
  (into {} (map (juxt :source :proofEfforts)) (:modules dafny-report)))

(defn policy-sources [{:keys [source sources]}]
  (cond source [source] (seq sources) sources :else nil))

(defn theorem-proof-efforts [claim policy]
  (if (= claim :complete-public-engine)
    (get-in dafny-report [:aggregate :proofEfforts])
    (let [counts (mapv #(get dafny-counts (.getName (io/file %)))
                       (policy-sources policy))]
      (when (every? integer? counts) (reduce + counts)))))

(def theorem-results
  (into
   (sorted-map)
   (map
    (fn [[claim policy]]
      (let [actual (theorem-proof-efforts claim policy)
            minimum (:minimum-proof-efforts policy)]
        [claim
         (assoc policy
                :proof-efforts actual
                :status (if (and (integer? actual) (<= minimum actual))
                          :passed
                          :failed))])))
   (:theorem-policies contract)))

(def mutation-registry
  (edn/read-string (slurp (repo-file "formal/mutations/registry.edn"))))

(def source-closure
  (json/parse-string (slurp (repo-file closure-path)) true))

(def stable-script
  (slurp (repo-file "formal/stable-discovery/verify-fast.sh")))

(def stable-discovery
  {:gate "formal/stable-discovery/verify-fast.sh"
   :dafny-leaves
   (count (files-under "formal/stable-discovery"
                       #(str/ends-with? (.getName %) ".dfy")))
   :verified-obligations
   (some->> stable-script
            (re-find #"expected_dafny_obligations=([0-9]+)")
            second
            parse-long)})

(def counterexample-ids
  (->> (files-under "formal/counterexamples" #(= "entry.edn" (.getName %)))
       (map #(-> % slurp edn/read-string :id))
       sort
       vec))

(def generated
  {:schema-version 2
   :contract "formal/assurance_contract.clj"
   :assurance-status (get-in contract [:release-policy :assurance-status])
   :release-policy (:release-policy contract)
   :theorems theorem-results
   :source-closure
   {:report (display-path closure-path)
    :source-files (count (:sources source-closure))
    :public-roots (get-in source-closure [:scope :rootCount])
    :reachable-definitions
    (get-in source-closure [:scope :unionInternalDefinitionCount])}
   :mutation-controls
   {:registry "formal/mutations/registry.edn"
    :registered (count (:mutants mutation-registry))
    :retired-invalid-controls
    (count (mapcat :ids (:retired-mutant-groups mutation-registry)))}
   :stable-discovery stable-discovery
   :source-digests
   (into (sorted-map)
         (map (fn [file] [(relative-path file) (file-digest file)]))
         source-files)
   :generated-artifact-digests generated-artifacts
   :counterexample-corpus-revision
   {:latest (last counterexample-ids)
    :fixed counterexample-ids}})

(let [output (repo-file output-path)]
  (io/make-parents output)
  (with-open [writer (io/writer output)]
    (binding [*out* writer] (pprint/pprint generated)))
  (println
   (pr-str
    {:status :generated
     :output (relative-path output)
     :source-files (count source-files)
     :theorems (count theorem-results)
     :source-closure (:source-closure generated)
     :mutation-controls (:mutation-controls generated)
     :generated-artifacts generated-artifacts})))
